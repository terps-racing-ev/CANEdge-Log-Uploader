CLIENT_ID=
TENANT_ID=
SITE_HOSTNAME=umd0.sharepoint.com
SITE_PATH=/TeamsTerpsRacingEV
OUTPUT_PARENT_SP_PATH=/General/path/to/CANedge Logs

# DST-aware Eastern time. Summer files are EDT; winter files are EST.
OUTPUT_TIMEZONE=America/New_York

# Must resolve to a multiple of 320 KiB; the app normalizes this value.
UPLOAD_CHUNK_MIB=10

# Decode all CAN buses by default. Set to a bus number such as 1 or 2
# if mirrored traffic should be decoded from only one bus.
DECODE_CAN_BUS=0

# Windows defaults to IPv4 to avoid broken university/corporate IPv6 routes.
# Set to 0 only when an IPv6-only connection is required.
# CANEDGE_FORCE_IPV4=0
